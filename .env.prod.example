# Copy to .env.prod and fill in. Generate each secret with:
#   openssl rand -base64 32

# The PostgreSQL superuser password (migrations and backups use this).
POSTGRES_PASSWORD=

# What the API connects as. Application permissions only — never the
# worker's cross-tenant functions.
EMIL_APP_PASSWORD=

# What the worker connects as.
EMIL_WORKER_PASSWORD=

# Signs every session token. 32+ characters, no default on purpose:
# a development fallback is the value that reaches production.
JWT_SECRET=

# The port the web app is published on (default 8080). Put Caddy or any
# TLS proxy in front of it for HTTPS — see docs/DEPLOY.md.
WEB_PORT=8080

# How many reverse proxies sit in front of the API, so its per-address rate
# limit keys on the real client IP rather than a proxy's. This is a COUNT of
# trusted hops — Fastify reads that many entries from the right of
# X-Forwarded-For. Get it wrong and a client either shares one rate-limit
# bucket with everyone (too low) or can forge its own IP to dodge the limit
# (too high), so set it to exactly the number of proxies you run.
#
#   (unset)  trust nobody — client IP is the socket peer. Correct with NO proxy.
#   1        one proxy in front of the API. Use this if browsers hit `web`
#            directly on WEB_PORT with nothing else ahead of it — `web`'s Next
#            rewrite is that one hop.
#   2        Caddy -> web -> api, the topology in docker/Caddyfile.example.
#
# A comma-separated CIDR list (e.g. 10.0.0.0/8) is also accepted for trusting
# specific proxy networks instead of a hop count. Leave unset until a proxy exists.
# TRUST_PROXY=2

# OPTIONAL — the in-app assistant. Get a key at console.anthropic.com.
# Leave empty and the assistant says "not connected" while everything else
# works; the how-to-use guides in the panel never need it.
ANTHROPIC_API_KEY=
