# Copy to .env.prod and fill in. Generate each secret with:
#   openssl rand -base64 32

# The PostgreSQL superuser password (migrations and backups use this).
POSTGRES_PASSWORD=

# What the API connects as. Application permissions only — never the
# worker's cross-tenant functions.
EMIL_APP_PASSWORD=

# What the worker connects as.
EMIL_WORKER_PASSWORD=

# Signs every session token. 32+ characters, no default on purpose:
# a development fallback is the value that reaches production.
JWT_SECRET=

# The port the web app is published on (default 8080). Put Caddy or any
# TLS proxy in front of it for HTTPS — see docs/DEPLOY.md.
WEB_PORT=8080
